+    #[test]
+    fn quiescence_hash_preference_preserves_eligibility_and_pruning() {
+        for fen in [
+            "7k/8/8/8/8/8/4Q3/4K3 w - - 0 1",
+            "4k3/8/8/8/8/8/4r3/4K3 w - - 0 1",
+            "3r3k/8/8/3p4/8/8/8/3Q3K w - - 0 1",
+            "7k/P7/8/8/8/8/8/4K3 w - - 0 1",
+            "4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1",
+        ] {
+            let board: cozy_chess::Board = fen.parse().unwrap();
+            let in_check = !board.checkers().is_empty();
+            let ordering = MoveOrdering::new();
+            for include_quiet_checks in [false, true] {
+                let mode = super::MovePickerMode::Quiescence {
+                    in_check,
+                    include_quiet_checks,
+                };
+                let make_picker = |preferred| {
+                    super::MovePicker::new(
+                        &board,
+                        super::MovePickerStorage::default(),
+                        preferred,
+                        0,
+                        None,
+                        super::EvaluationConfig::new(75),
+                        mode,
+                    )
+                };
+                let describe = |metadata: super::MoveMetadata| {
+                    (
+                        super::move_key(metadata.chess_move),
+                        metadata.see,
+                        metadata.gives_check,
+                        super::should_prune_quiescence_capture(metadata, in_check, None),
+                        super::should_prune_quiescence_capture(
+                            metadata,
+                            in_check,
+                            Some(metadata.chess_move.to),
+                        ),
+                    )
+                };
+                let mut ordinary = make_picker(None);
+                let mut expected = Vec::new();
+                while let Some((_, metadata)) = ordinary.next(&ordering) {
+                    expected.push(describe(metadata));
+                }
+                expected.sort_unstable();
+                let mut preferences = generate_moves(&board);
+                preferences.push("a1a8".parse().unwrap());
+                for preferred in preferences {
+                    let mut picker = make_picker(Some(preferred));
+                    let first = picker.next(&ordering);
+                    if expected
+                        .iter()
+                        .any(|entry| entry.0 == super::move_key(preferred))
+                    {
+                        assert_eq!(first.unwrap().1.chess_move, preferred);
+                        assert_eq!(picker.work().tactical_generations, 0);
+                        assert_eq!(picker.work().quiet_generations, 0);
+                    }
+                    let mut actual = first
+                        .into_iter()
+                        .map(|(_, m)| describe(m))
+                        .collect::<Vec<_>>();
+                    while let Some((_, metadata)) = picker.next(&ordering) {
+                        actual.push(describe(metadata));
+                    }
+                    actual.sort_unstable();
+                    assert_eq!(
+                        actual, expected,
+                        "{fen}: {preferred}, checks={include_quiet_checks}"
+                    );
+                }
+            }
+        }
+    }
