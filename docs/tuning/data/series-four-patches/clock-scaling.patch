+/// Scales the soft limit by what the last iteration said about the root.
+///
+/// A best move that absorbed most of the root's nodes was never in doubt and
+/// the clock is spent elsewhere; one that took a small share of them won a
+/// contest, and the next iteration may reverse it. A best move that has held
+/// for several iterations earns less time again, and one that has just
+/// changed earns more. Both only apply under a real clock: a fixed move time
+/// has soft and hard limits equal, and is not scaled.
+fn scaled_soft_limit(
+    deadline: DeadlineWindow,
+    best_move_share_percent: Option<u64>,
+    stable_iterations: u64,
+) -> Duration {
+    if deadline.soft >= deadline.hard {
+        return deadline.soft;
+    }
+    let effort_scale = best_move_share_percent.map_or(100, |share| {
+        EFFORT_SCALE_BASE
+            .saturating_sub(share)
+            .clamp(EFFORT_SCALE_MIN, EFFORT_SCALE_MAX)
+    });
+    let stability_scale = STABILITY_SCALE_BASE
+        - STABILITY_SCALE_STEP * stable_iterations.min(STABILITY_SCALE_ITERATIONS);
+    let scaled = deadline
+        .soft
+        .saturating_mul(effort_scale as u32)
+        .saturating_mul(stability_scale as u32)
+        / 10_000;
+    scaled.min(deadline.hard)
+}
