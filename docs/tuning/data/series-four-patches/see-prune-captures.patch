+/// Reports whether an interior capture loses too much material to search.
+///
+/// Quiescence already skips captures the swap list refutes. In the ordinary
+/// search a losing capture was always searched, at full depth less its
+/// reduction, however far below zero the swap list put it. Past the first
+/// move, at shallow non-PV nodes, a capture that loses more than a margin
+/// growing with the square of the remaining depth is skipped instead. The
+/// exemptions are quiescence's: promotions, checks, captures into the enemy
+/// king's zone, attacking pawn pushes and the recapture of the square just
+/// vacated are all searched, so the forcing captures the personality is
+/// built from are not touched.
+fn should_prune_losing_capture(
+    depth: u32,
+    move_index: usize,
+    metadata: MoveMetadata,
+    in_check: bool,
+    pv_node: bool,
+    recapture_square: Option<Square>,
+    mode: SearchMode,
+) -> bool {
+    matches!(mode, SearchMode::Normal)
+        && depth <= SEE_PRUNE_MAX_DEPTH
+        && move_index > 0
+        && !pv_node
+        && !in_check
+        && metadata.captured.is_some()
+        && metadata.chess_move.promotion.is_none()
+        && !metadata.gives_check
+        && !metadata.king_zone_move
+        && !metadata.attacking_pawn_push
+        && Some(metadata.chess_move.to) != recapture_square
+        && metadata
+            .see
+            .is_some_and(|see| see < -SEE_PRUNE_DEPTH_MARGIN * depth as Score)
+}
