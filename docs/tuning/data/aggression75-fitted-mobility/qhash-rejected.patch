+    #[test]
+    fn quiescence_uses_a_non_cutting_hash_move_for_the_first_capture() {
+        let position = Position::from_fen("7k/8/4p3/8/1p2Q3/8/8/7K w - - 0 1").unwrap();
+        let board = position.board();
+        let control = super::SearchControl::new();
+        let table = super::TranspositionTable::new(1).unwrap();
+        table.start_search(0);
+        let mut context =
+            super::SearchContext::for_test(&table, &control, super::SearchMode::Normal);
+        let mut history = RepetitionTracker::new(position.hash_history());
+        let mut picker = super::MovePicker::new(
+            board,
+            super::MovePickerStorage::default(),
+            None,
+            0,
+            None,
+            context.personality,
+            super::MovePickerMode::Quiescence {
+                in_check: false,
+                include_quiet_checks: false,
+            },
+        );
+        let first = picker.next(&context.ordering).unwrap().1.chess_move;
+        let preferred = picker.next(&context.ordering).unwrap().1.chess_move;
+        assert_ne!(first, preferred);
+        let stand_pat = super::evaluate_with_config(board, context.scoring);
+        let beta = stand_pat + 1;
+        table.store_key(
+            history.current_key(),
+            board.halfmove_clock(),
+            0,
+            0,
+            beta + 100,
+            super::Bound::Upper,
+            Some(preferred),
+            None,
+        );
+        let result = super::quiescence(
+            board,
+            &mut history,
+            0,
+            super::NEG_INFINITY,
+            beta,
+            1,
+            0,
+            None,
+            true,
+            &mut context,
+        )
+        .unwrap();
+        assert!(result.score >= beta);
+        assert_eq!(context.pv(0).first(), Some(&preferred));
+        assert_eq!(context.telemetry.tt_cutoffs, 0);
+        assert_eq!(context.telemetry.capture_cutoffs, 1);
+        assert_eq!(context.telemetry.capture_cutoff_index_sum, 0);
+    }
