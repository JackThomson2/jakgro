+    fn attack_candidate(
+        chess_move: &str,
+        interest: i64,
+        gain: super::Score,
+    ) -> super::RootCandidate {
+        super::RootCandidate {
+            chess_move: chess_move.parse().unwrap(),
+            score: 50,
+            path_dependent: false,
+            interest,
+            pv: Vec::new(),
+            sacrifice: super::SacrificeProfile {
+                verified_reply: true,
+                attack_gain: gain,
+                ..super::SacrificeProfile::default()
+            },
+            outcome: super::RootLineOutcome::Live,
+            sterile_simplification: false,
+        }
+    }
+
+    #[test]
+    fn ordinary_attacks_must_survive_defense_and_keep_the_king_safe() {
+        let config = super::EvaluationConfig::new(75);
+        let mut candidates = vec![
+            attack_candidate("e2e4", 1000, 0),
+            attack_candidate("d2d4", 10, 30),
+        ];
+        assert_eq!(super::choose_styled_candidate(&candidates, 0, config), 1);
+        candidates[1].sacrifice.king_danger_delta = 40;
+        assert_eq!(super::choose_styled_candidate(&candidates, 0, config), 0);
+        candidates[1].sacrifice.king_danger_delta = 0;
+        candidates[1].sacrifice.verified_reply = false;
+        assert_eq!(super::choose_styled_candidate(&candidates, 0, config), 0);
+        candidates[1].sacrifice.verified_reply = true;
+        candidates[1].score = 23;
+        assert_eq!(super::choose_styled_candidate(&candidates, 0, config), 0);
+    }
