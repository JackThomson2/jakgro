+/// Prefer pressure that survives the searched reply over immediate spectacle.
+/// The sacrifice profile also carries reply evidence for ordinary moves. Missing
+/// replies confer no new preference, and verified investments keep priority.
+fn attack_selection_rank(
+    candidate: &RootCandidate,
+    evaluation: EvaluationConfig,
+    best_score: Score,
+) -> (bool, Score, i64) {
+    let sacrifice = &candidate.sacrifice;
+    let compensated = is_compensated_sacrifice(sacrifice);
+    let sustained = if !compensated && sacrifice.verified_reply {
+        sacrifice.attack_gain - sacrifice.king_danger_delta.max(0)
+    } else {
+        0
+    };
+    (
+        compensated,
+        sustained,
+        selection_interest(candidate, evaluation, best_score),
+    )
+}
