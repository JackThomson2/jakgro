index 374725a..7916881 100644
--- a/src/engine/search/algorithm.rs
+++ b/src/engine/search/algorithm.rs
@@ -27,7 +27,10 @@ use crate::engine::position::repetition_key;
 const DEFAULT_DEPTH: u32 = 4;
 const MAX_DEPTH: u32 = 64;
 const QUIESCENCE_DEPTH: u32 = 16;
-const ASPIRATION_INITIAL: Score = 50;
+/// Half-width of the first aspiration window around the previous score.
+const ASPIRATION_INITIAL: Score = 30;
+/// Score swing between iterations that marks a search volatile.
+const VOLATILE_SCORE_SWING: Score = 50;
 const VOLATILE_HOLD_ITERATIONS: u8 = 2;
 pub(super) const CONTROL_POLL_INTERVAL_NODES: u64 = 256;
 const ITERATION_TIME_MULTIPLIER: u32 = 2;
@@ -130,7 +133,7 @@ impl IterationStability {
         let best_move_changed = self.best_move.is_some() && self.best_move != best_move;
         let score_changed = self
             .score
-            .is_some_and(|previous| previous.abs_diff(score) >= ASPIRATION_INITIAL as u32);
+            .is_some_and(|previous| previous.abs_diff(score) >= VOLATILE_SCORE_SWING as u32);
         if best_move_changed || score_changed {
             self.volatile_for = VOLATILE_HOLD_ITERATIONS;
         } else {
@@ -2263,12 +2266,15 @@ fn run_worker(
                 break iteration;
             }
 
+            // A failed window widens and moves to where the score went, so
+            // a fail-low is retried below the previous score rather than
+            // around it, and a fail-high above.
             radius = radius.saturating_mul(2);
             if iteration.primary_score.abs() >= MATE_THRESHOLD || radius >= POS_INFINITY {
                 alpha = NEG_INFINITY;
                 beta = POS_INFINITY;
-            } else if let Some(score) = previous_score {
-                (alpha, beta) = aspiration_bounds(score, radius);
+            } else {
+                (alpha, beta) = aspiration_bounds(iteration.primary_score, radius);
             }
         };
         let iteration_duration = iteration_started.elapsed();
