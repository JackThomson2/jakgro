+    /// The soft limit shrinks when the best move dominated the root or has
+    /// held for several iterations, grows when it was contested or has just
+    /// changed, never exceeds the hard limit, and is untouched at a fixed
+    /// move time.
+    #[test]
+    fn the_soft_limit_scales_with_root_effort_and_stability() {
+        use std::time::Duration;
+
+        use super::{DeadlineWindow, scaled_soft_limit};
+
+        let clock = DeadlineWindow {
+            soft: Duration::from_millis(100),
+            hard: Duration::from_millis(300),
+        };
+        let neutral = scaled_soft_limit(clock, Some(60), 2);
+        assert_eq!(neutral, Duration::from_millis(100));
+        assert!(scaled_soft_limit(clock, Some(95), 2) < neutral);
+        assert!(scaled_soft_limit(clock, Some(20), 2) > neutral);
+        assert!(scaled_soft_limit(clock, Some(60), 0) > neutral);
+        assert!(scaled_soft_limit(clock, Some(60), 8) < neutral);
+        assert_eq!(scaled_soft_limit(clock, None, 2), neutral);
+        // Bounded on both sides.
+        assert_eq!(
+            scaled_soft_limit(clock, Some(100), 8),
+            Duration::from_millis(100 * 70 * 90 / 10_000)
+        );
+        assert_eq!(
+            scaled_soft_limit(clock, Some(0), 0),
+            Duration::from_millis(100 * 130 * 110 / 10_000)
+        );
+        let tight = DeadlineWindow {
+            soft: Duration::from_millis(100),
+            hard: Duration::from_millis(120),
+        };
+        assert_eq!(
+            scaled_soft_limit(tight, Some(0), 0),
+            Duration::from_millis(120)
+        );
+
+        let fixed = DeadlineWindow {
+            soft: Duration::from_millis(100),
+            hard: Duration::from_millis(100),
+        };
+        assert_eq!(
+            scaled_soft_limit(fixed, Some(100), 8),
+            Duration::from_millis(100)
+        );
+    }
