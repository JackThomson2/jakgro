+    #[test]
+    fn conversion_metadata_is_consumed_only_at_the_shared_boundary() {
+        for (aggression, best, enabled) in [
+            (0, 201, false),
+            (74, 199, false),
+            (74, 200, false),
+            (75, 199, false),
+            (75, 200, true),
+            (75, 201, true),
+            (100, 199, false),
+            (100, 200, true),
+        ] {
+            let evaluation = super::EvaluationConfig::new(aggression);
+            assert_eq!(
+                super::conversion_aversion_applies(evaluation, best),
+                enabled
+            );
+            for score in [best - 1, best + 1] {
+                let mut candidate = super::RootCandidate {
+                    chess_move: "e2e4".parse().unwrap(),
+                    score,
+                    path_dependent: false,
+                    interest: 100,
+                    pv: vec![],
+                    sacrifice: super::SacrificeProfile::default(),
+                    outcome: super::RootLineOutcome::RepetitionDraw,
+                    sterile_simplification: true,
+                };
+                let eager = super::selection_interest(&candidate, evaluation, best);
+                candidate.outcome = super::RootLineOutcome::Live;
+                candidate.sterile_simplification = false;
+                let neutral = super::selection_interest(&candidate, evaluation, best);
+                if enabled {
+                    assert!(eager < neutral);
+                } else {
+                    assert_eq!(eager, neutral);
+                }
+            }
+        }
+    }
