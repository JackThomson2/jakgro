+    #[test]
+    fn reply_attack_evidence_is_color_symmetric() {
+        let cases = [
+            (
+                "2kr3r/pppq1ppp/2n1bn2/3p4/3P4/2P1PN2/PP1N1PPP/R2Q1RK1 w - - 0 10",
+                "b2b4",
+                "h7h6",
+            ),
+            (
+                "r2q1rk1/pp1n1ppp/2p1pn2/3p4/3P4/2N1BN2/PPPQ1PPP/2KR3R b - - 0 10",
+                "b7b5",
+                "h2h3",
+            ),
+        ];
+        let ranks = cases.map(|(fen, first, reply)| {
+            let position = Position::from_fen(fen).unwrap();
+            let root = position.board();
+            let chess_move = first.parse().unwrap();
+            let mut child = root.clone();
+            child.play(chess_move);
+            let mut candidate = attack_candidate(first, 0, 0);
+            candidate.sacrifice = super::sacrifice_profile(
+                root,
+                &child,
+                root.side_to_move(),
+                &[chess_move, reply.parse().unwrap()],
+            );
+            assert!(candidate.sacrifice.verified_reply);
+            super::attack_selection_rank(&candidate, super::EvaluationConfig::new(75), 50)
+        });
+        assert_eq!(ranks[0], ranks[1]);
+    }
