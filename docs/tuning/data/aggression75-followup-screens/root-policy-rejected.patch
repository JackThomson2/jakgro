+    #[test]
+    fn winning_positions_do_not_loosen_ordinary_root_risk() {
+        let ordinary = super::SacrificeProfile::default();
+        for aggression in 0..=100 {
+            let evaluation = super::EvaluationConfig::new(aggression);
+            let before =
+                super::candidate_risk_margin(evaluation, super::WINNING_ROOT_SCORE - 1, &ordinary);
+            let winning =
+                super::candidate_risk_margin(evaluation, super::WINNING_ROOT_SCORE, &ordinary);
+            assert!(winning <= before, "aggression {aggression}");
+        }
+        let default = super::EvaluationConfig::default();
+        for best in [-200, 0, 199, 200, 201, 400] {
+            assert_eq!(super::candidate_risk_margin(default, best, &ordinary), 16);
+        }
+        let verified = super::SacrificeProfile {
+            state: super::SacrificeState::Accepted,
+            settled_exchange: true,
+            offered_cp: 330,
+            accepted_cp: 330,
+            attack_gain: 10,
+            legal_checks: 1,
+            compensation_signals: 3,
+            position_stable: true,
+            verified_reply: true,
+            ..super::SacrificeProfile::default()
+        };
+        assert_eq!(super::candidate_risk_margin(default, 199, &verified), 67);
+        assert_eq!(super::candidate_risk_margin(default, 200, &verified), 20);
+    }
