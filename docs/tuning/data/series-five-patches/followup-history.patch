+    #[test]
+    fn followup_history_reads_the_side_own_previous_move() {
+        let position = Position::default();
+        let winner = find_move(&position, "d2d4");
+        let failed = find_move(&position, "e2e4");
+        let failed_metadata = super::MoveMetadata::classify(position.board(), failed);
+        let reply = HistoryMove {
+            piece: Piece::Knight,
+            to: Square::F6,
+        };
+        let own_previous = HistoryMove {
+            piece: Piece::Knight,
+            to: Square::F3,
+        };
+        let current = HistoryMove::from_board(position.board(), winner);
+        let failed_current = HistoryMove::from_board(position.board(), failed);
+        let mut ordering = MoveOrdering::new();
+        // The side to move at ply two played `own_previous` from ply zero,
+        // which the stack records as the move that led to ply one.
+        ordering.played[1] = Some(own_previous);
+        assert_eq!(ordering.followup_of(2), Some(own_previous));
+        assert_eq!(ordering.followup_of(0), None);
+
+        ordering.record_quiet_cutoff(
+            position.board(),
+            Some(reply),
+            winner,
+            &[failed_metadata],
+            2,
+            8,
+        );
+
+        assert!(ordering.followup_score(own_previous, current) > 0);
+        assert!(ordering.followup_score(own_previous, failed_current) < 0);
+        // At ply two the follow-up agrees and adds; at ply zero there is none.
+        assert!(
+            ordering.quiet_history_score(position.board(), winner, Some(reply), 2)
+                > ordering.quiet_history_score(position.board(), winner, Some(reply), 0)
+        );
+        // A follow-up that disagrees with the butterfly sign is ignored.
+        ordering.update_followup(own_previous, current, -super::HISTORY_MAX);
+        assert_eq!(
+            ordering.quiet_history_score(position.board(), winner, Some(reply), 2),
+            ordering.quiet_history_score(position.board(), winner, Some(reply), 0),
+        );
+    }
