+    /// The correction history learns per pawn structure and side to move,
+    /// decays toward what search keeps finding, and stays bounded.
+    #[test]
+    fn correction_history_learns_bounded_per_structure_and_side() {
+        let mut correction = super::CorrectionHistory::new();
+        let board: cozy_chess::Board =
+            "r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w KQkq - 2 3"
+                .parse()
+                .unwrap();
+        let other_pawns: cozy_chess::Board =
+            "r1bqkbnr/pppp1ppp/2n5/4p3/3PP3/5N2/PPP2PPP/RNBQKB1R w KQkq - 0 3"
+                .parse()
+                .unwrap();
+        let other_side: cozy_chess::Board =
+            "r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R b KQkq - 2 3"
+                .parse()
+                .unwrap();
+        assert_eq!(correction.correction(&board), 0);
+
+        for _ in 0..64 {
+            correction.update(&board, 6, 40);
+        }
+        let learned = correction.correction(&board);
+        assert!(learned > 20 && learned <= 40, "learned {learned}");
+        // A different pawn structure is another pawn entry but shares the
+        // material entry, which contributes half; the other side to move
+        // shares nothing.
+        assert!(correction.correction(&other_pawns) < learned);
+        assert!(correction.correction(&other_pawns) > 0);
+        assert_eq!(correction.correction(&other_side), 0);
+
+        for _ in 0..256 {
+            correction.update(&board, 12, 1_000);
+        }
+        assert_eq!(correction.correction(&board), super::CORRECTION_LIMIT);
+        for _ in 0..256 {
+            correction.update(&board, 12, -1_000);
+        }
+        assert_eq!(correction.correction(&board), -super::CORRECTION_LIMIT);
+    }
