+/// What search has learned about where the static evaluation is wrong.
+///
+/// The evaluation is a fixed function of the position, so where it is wrong
+/// it is wrong the same way every time the same pawn structure, or the same
+/// material, comes up — and search already knows, because the score it
+/// returns after looking disagrees with the static score in a direction that
+/// repeats. Two tables accumulate that disagreement as a decaying average,
+/// one keyed by the pawn structure and one by the non-pawn material, both by
+/// side to move. Every rule that reads the evaluation reads the corrected
+/// value, the quiescence stand-pat included; the transposition table keeps
+/// the raw one, so what it caches stays a pure function of the position.
+///
+/// The third series measured this without the stand-pat and found it inert:
+/// quiescence is most of the tree and its stand-pat is the evaluation used
+/// most. Correcting it is the half that was not tried.
+struct CorrectionHistory {
+    pawn: Vec<i32>,
+    material: Vec<i32>,
+}
+
+/// Entries per side to move in each correction table.
+const CORRECTION_ENTRIES: usize = 16_384;
+/// Fixed-point grain of a correction entry, in units per centipawn.
+const CORRECTION_GRAIN: i32 = 256;
+/// The most a correction may move the static evaluation, in centipawns.
+const CORRECTION_LIMIT: Score = 48;
+/// The most one result may contribute, in centipawns.
+const CORRECTION_DELTA_LIMIT: Score = 128;
+/// Deepest result weight in the decaying average, out of [`CORRECTION_GRAIN`].
+const CORRECTION_MAX_WEIGHT: i32 = 16;
+
+impl CorrectionHistory {
+    fn new() -> Self {
+        Self {
+            pawn: vec![0; 2 * CORRECTION_ENTRIES],
+            material: vec![0; 2 * CORRECTION_ENTRIES],
+        }
+    }
+
+    /// Returns the two table slots a position reads and writes.
+    fn slots(board: &Board) -> (usize, usize) {
+        let side = board.side_to_move() as usize * CORRECTION_ENTRIES;
+        let white_pawns = board.colored_pieces(Color::White, Piece::Pawn).0;
+        let black_pawns = board.colored_pieces(Color::Black, Piece::Pawn).0;
+        let pawn_key = mix(white_pawns) ^ mix(black_pawns.rotate_left(32));
+        let mut material_key = 0_u64;
+        for color in [Color::White, Color::Black] {
+            for piece in [Piece::Knight, Piece::Bishop, Piece::Rook, Piece::Queen] {
+                material_key = material_key * 11 + board.colored_pieces(color, piece).len() as u64;
+            }
+        }
+        let mask = CORRECTION_ENTRIES - 1;
+        (
+            side + ((pawn_key >> 20) as usize & mask),
+            side + ((mix(material_key) >> 20) as usize & mask),
+        )
+    }
+
+    /// Returns the centipawns to add to this position's static evaluation.
+    fn correction(&self, board: &Board) -> Score {
+        let (pawn, material) = Self::slots(board);
+        ((self.pawn[pawn] + self.material[material]) / 2 / CORRECTION_GRAIN)
+            .clamp(-CORRECTION_LIMIT, CORRECTION_LIMIT)
+    }
+
+    /// Folds a search result's disagreement with the static evaluation in.
+    ///
+    /// Deeper results weigh more, up to a cap, so a depth-one fail-low does
+    /// not overwrite what a depth-ten search established.
+    fn update(&mut self, board: &Board, depth: u32, delta: Score) {
+        let (pawn, material) = Self::slots(board);
+        let weight = (depth as i32 + 1).min(CORRECTION_MAX_WEIGHT);
+        let target =
+            delta.clamp(-CORRECTION_DELTA_LIMIT, CORRECTION_DELTA_LIMIT) * CORRECTION_GRAIN;
+        let limit = CORRECTION_LIMIT * CORRECTION_GRAIN;
+        for entry in [&mut self.pawn[pawn], &mut self.material[material]] {
+            *entry = ((*entry * (CORRECTION_GRAIN - weight) + target * weight) / CORRECTION_GRAIN)
+                .clamp(-limit, limit);
+        }
+    }
+}
+
+/// Scrambles a key so that similar inputs land in different slots.
+const fn mix(mut key: u64) -> u64 {
+    key ^= key >> 30;
+    key = key.wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    key ^= key >> 27;
+    key = key.wrapping_mul(0x94D0_49BB_1331_11EB);
+    key ^ (key >> 31)
+}
