+/// Probe ordinary moves against the score guard they must eventually pass.
+/// A sacrifice hint can retain the wider window until its compensation is
+/// verified, but winning conversions always have the tighter guard.
+fn provisional_candidate_margin(
+    evaluation: EvaluationConfig,
+    best_score: Score,
+    sacrifice_hint: Score,
+) -> Score {
+    if best_score < WINNING_ROOT_SCORE && sacrifice_hint >= MIN_SACRIFICE_CP {
+        evaluation.root_style_margin().min(120)
+    } else {
+        candidate_risk_margin(evaluation, best_score, &SacrificeProfile::default())
+    }
+}
